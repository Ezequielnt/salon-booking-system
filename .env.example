# Copiá este archivo a .env y ajustá lo que necesites:
#   cp .env.example .env
#
# docker-compose ya inyecta estos valores a los contenedores.
# Para correr el backend fuera de Docker, colocá una copia en backend/.env.

# --- Django ---------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=cambiame-por-un-valor-random
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos (PostgreSQL) -----------------------------------
DATABASE_URL=postgres://salon:salon@db:5432/salon
POSTGRES_DB=salon
POSTGRES_USER=salon
POSTGRES_PASSWORD=salon

# --- Redis / Celery ------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- CORS (frontend Vite) ---------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Email (Mailpit en la demo: UI en http://localhost:8025) ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=no-reply@salon.local

# --- Pagos --------------------------------------------------------
# fake = proveedor simulado, no requiere cuenta (por defecto).
# mercadopago = requiere MERCADOPAGO_ACCESS_TOKEN de una cuenta de test.
PAYMENTS_PROVIDER=fake
MERCADOPAGO_ACCESS_TOKEN=

# --- Frontend ---------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
